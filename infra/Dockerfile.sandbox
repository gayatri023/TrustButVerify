# Sandbox image for agent and scoring containers.
# TODO(you): after the first build run `docker inspect --format '{{index .RepoDigests 0}}' python:3.12-slim`
# and pin the base image by digest here, then record it in docs/ASSUMPTIONS.md.
FROM python:3.12-slim
RUN pip install --no-cache-dir pytest==8.* \
 && useradd -m -u 1000 agent
USER 1000:1000
WORKDIR /workspace
